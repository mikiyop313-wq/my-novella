{
  "name": "my-novella",
  "version": "0.1.5",
  "productName": "My Novella",
  "main": "dist-electron/main.js",
  "scripts": {
    "ng": "ng",
    "ng:serve": "ng serve",
    "electron:serve": "wait-on http-get://localhost:4200 && vite",
    "dev": "concurrently \"npm run ng:serve\" \"npm run electron:serve\"",
    "start": "ng serve",
    "build:electron": "vite build",
    "build": "npm run build:electron && ng build",
    "dist:win": "npm run build && electron-builder --win nsis --x64",
    "release:win": "npm run build && electron-builder --win nsis --x64 --publish always",
    "postinstall": "patch-package && npm run rebuild",
    "rebuild": "electron-rebuild -f -o better-sqlite3,@lancedb/lancedb",
    "watch": "ng build --watch --configuration development",
    "test": "ng test",
    "test:electron": "vitest run electron/domain/update electron/ipc/update electron/__tests__/app-close-coordinator.spec.ts",
    "electron": "npm run build:electron && electron .",
    "db:migrate": "kysely migrate latest",
    "db:migrate:rollback": "kysely migrate rollback",
    "db:migrate:make": "kysely migrate make",
    "db:vectors:reset": "node vectors/reset-vectors.mjs"
  },
  "private": true,
  "packageManager": "npm@11.11.0",
  "dependencies": {
    "@angular/animations": "^21.2.8",
    "@angular/cdk": "^21.2.9",
    "@angular/common": "^21.2.0",
    "@angular/compiler": "^21.2.0",
    "@angular/core": "^21.2.0",
    "@angular/forms": "^21.2.0",
    "@angular/platform-browser": "^21.2.0",
    "@angular/router": "^21.2.0",
    "@codemirror/commands": "^6.10.4",
    "@codemirror/lang-markdown": "^6.5.0",
    "@codemirror/language": "^6.12.4",
    "@codemirror/state": "^6.7.1",
    "@codemirror/view": "^6.43.6",
    "@lancedb/lancedb": "^0.27.2",
    "@ngrx/signals": "^21.1.0",
    "@tiptap/core": "^3.23.4",
    "@tiptap/extension-paragraph": "^3.23.4",
    "@tiptap/extension-placeholder": "^3.23.4",
    "@tiptap/markdown": "^3.23.4",
    "@tiptap/pm": "^3.23.4",
    "@tiptap/starter-kit": "^3.23.4",
    "@xenova/transformers": "^2.17.2",
    "apache-arrow": "^18.1.0",
    "better-sqlite3": "^12.9.0",
    "docx": "^9.7.1",
    "electron-updater": "^6.8.9",
    "jszip": "^3.10.1",
    "kysely": "^0.29.5",
    "marked": "^18.0.5",
    "ngx-markdown": "^21.3.0",
    "ngx-tiptap": "^14.0.1",
    "rxjs": "~7.8.0",
    "tslib": "^2.3.0"
  },
  "devDependencies": {
    "@angular/build": "^21.2.7",
    "@angular/cli": "^21.2.7",
    "@angular/compiler-cli": "^21.2.0",
    "@electron/rebuild": "^4.0.3",
    "@types/better-sqlite3": "^7.6.13",
    "concurrently": "^9.2.1",
    "electron": "^41.2.0",
    "electron-builder": "^26.15.3",
    "jsdom": "^28.0.0",
    "kysely-ctl": "^0.21.0",
    "patch-package": "^8.0.1",
    "prettier": "^3.8.1",
    "typescript": "~5.9.2",
    "vite": "^7.3.2",
    "vite-plugin-electron": "^0.29.1",
    "vitest": "^4.0.8",
    "wait-on": "^9.0.5"
  }
}
